# Copy to .env and replace every placeholder. Never commit .env.

# Google OAuth: create a Web application OAuth client in Google Cloud Console.
# Redirect URI: http://localhost:4173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional native app OAuth clients from the same Google Cloud project.
# GOOGLE_CLIENT_ID remains the web client ID and must be first in auth config.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Sign in with Apple (needed for an iOS App Store release alongside Google).
# APPLE_CLIENT_ID is the Apple Service ID. The app bundle ID defaults to
# com.closer.couples; keep it aligned with the native project identifier.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_APP_BUNDLE_IDENTIFIER=com.closer.couples
# Require Apple credentials when preparing the backend for an iOS store release.
# Google-only staging can run without Apple or AI credentials.
REQUIRE_APPLE_SIGN_IN=false

# PostgreSQL connection string for your own hosted PostgreSQL database.
DATABASE_URL=postgresql://closer:change-me@localhost:5432/closer
# Keep this bounded against your DB connection limit and max app instances.
DATABASE_POOL_SIZE=5
DATABASE_CONNECTION_MAX_LIFETIME_SECONDS=1800
DATABASE_SSL=false

# Private Google Cloud Storage bucket for shared and private diary photos.
# The Cloud Run service account needs permission to create objects and sign
# short-lived read URLs. Leave unset in local preview to disable cloud photos.
GCS_BUCKET=

# Set BETTER_AUTH_URL to the public app origin in production.
BETTER_AUTH_URL=http://localhost:4173
# Generate a random secret of at least 32 characters; do not reuse an API key.
BETTER_AUTH_SECRET=
# Comma-separated exact origins permitted to start a sign-in flow.
# Include the deployed web origin and Capacitor origins when the mobile app calls
# the API on a separate HTTPS host. Keep this as an exact comma-separated list.
APP_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,capacitor://localhost,https://localhost
# Becomes required in production or whenever all auth credentials are configured.
# Set false only to return to the local sample-profile preview.
AUTH_REQUIRED=

# Keep real AI credentials server-side; never expose them to browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
